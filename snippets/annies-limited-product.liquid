{% style %}

.limited-product-popup-wrap{
  position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background-color: rgba(0,0,0,0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
}

.limited-product-popup-wrap-inner {
  background: white;
      padding: 40px;
      border-radius: 8px;
      position: relative;
      max-width: 350px;
      text-align: center;
}

.limited-product-popup-wrap-inner #close-popup {
    position: absolute;
    top: 10px;
    right: 10px;
    background: none;
    border: none;
    font-size: 18px;
    cursor: pointer;
    transform: rotate(45deg);
}

.limited-product-popup-wrap-inner p{
  margin: 0
}

{% endstyle %}

<div id="limited-product-popup" style="display: none;">
  <div class="limited-product-popup-wrap">
    <div class="limited-product-popup-wrap-inner">
      <button id="close-popup">+</button>
      <p>You can only add one of this product to your cart.</p>
    </div>
  </div>
</div>
