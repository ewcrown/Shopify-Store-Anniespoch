<div class="side-panel cart-drawer has-shadow--false" id="Cart-Drawer" tabindex="-1">
  <div class="side-panel-inner">
    <div class="side-panel-header">
      <div>
        <div class="count-p">
          <span class="h6">Your Cart</span> <span id="cart-item-count">({{ cart.item_count }})</span>
        </div>

        <side-panel-close class="side-panel-close">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M13 1L1 13M13 13L1 1" stroke="var(--color-body)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </side-panel-close>
      </div>
    </div>

    <div class="side-panel-content">
      <div class="product-cart-item--container">
        {% if cart.item_count > 0 %}
          {% for item in cart.items %}
            {% assign item_key = item.key %}
            {% assign item_quantity = item.quantity %}

            <div class="product-cart-item" id="CartDrawerItem-{{ forloop.index }}">
              <div class="product-cart-item-image">
                <img
                  src="{{ item.image | image_url: width: '300x300' }}"
                  alt="{{ item.title }}"
                  sizes="75px"
                  loading="lazy"
                  width=""
                  height=""
                >
              </div>
              <div class="product-cart-item-info">
                <a href="{{ item.url }}" title="{{ item.title }}" class="cart-product-link">{{ item.title }}</a>
                <span class="price"
                  ><ins
                    ><span class="amount">{{ item.final_price | money }}</span></ins
                  ></span
                >
                <div class="product-cart-item-options">{{ item.variant_title }}</div>

                <div class="quantity cart-update small-qty buttons_added" data-id="{{ item_key }}">
                  <button
                    class="minus"
                    type="button"
                    aria-label="Decrease quantity for {{ item.title }}"
                    onclick="updateCartItem('{{ item_key }}', {{ item_quantity | minus: 1 }}, this.nextElementSibling)"
                  >
                    <svg width="8" height="2" viewBox="0 0 8 2" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M1 1H7" stroke="var(--color-body)" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                  </button>

                  <input
                    type="number"
                    id="updates_{{ item_key }}"
                    value="{{ item_quantity }}"
                    min="1"
                    step="1"
                    class="qty"
                    aria-label="Quantity for {{ item.title }}"
                    onchange="updateCartItem('{{ item_key }}', this.value, this)"
                  >

                  <button
                    class="plus"
                    type="button"
                    aria-label="Increase quantity for {{ item.title }}"
                    onclick="updateCartItem('{{ item_key }}', {{ item_quantity | plus: 1 }}, this.previousElementSibling)"
                  >
                    <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M1 5H9" stroke="var(--color-body)" stroke-linecap="round" stroke-linejoin="round"></path>
                      <path d="M5 1V9" stroke="var(--color-body)" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                  </button>
                </div>

                <a href="javascript:void(0);" class="remove" onclick="updateCartItem('{{ item_key }}', 0)">
                  <svg width="13" height="14" viewBox="0 0 13 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 3L1 3M5 6V10M8 6V10M11 3V12.5C11 12.6326 10.9476 12.7598 10.8538 12.8536C10.76 12.9473 10.6329 13 10.5 13H2.5C2.3676 13 2.2404 12.9473 2.1467 12.8536C2.0529 12.7598 2 12.6326 2 12.5V3M9 3V2C9 1.7348 8.8949 1.4804 8.7073 1.2929C8.5198 1.1054 8.2655 1 8 1H5C4.735 1 4.4807 1.1054 4.2931 1.2929C4.1056 1.4804 4 1.7348 4 2V3" stroke="#E93636" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </a>
              </div>
            </div>
          {% endfor %}
        {% else %}
          <div class="cart-empty-state">
            <p>Your cart is currently empty.</p>
            <a href="/collections/all" class="button">Continue Shopping</a>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="side-panel-footer">
      <div class="cart-drawer-footer">
        <table class="collaterals">
          <tbody>
            <tr class="cart-total">
              <th>
                Total
                {% comment %}
                  <p class="cart-policy-text">
                    Tax included. <a href="/policies/shipping-policy">Shipping</a> calculated at checkout.
                  </p>
                {% endcomment %}
              </th>
              <td>
                <span class="price"
                  ><span class="amount">{{ cart.total_price | money }}</span></span
                >
              </td>
            </tr>
          </tbody>
        </table>

        <button type="button" class="order-note-toggle" id="order-note-toggle" aria-controls="mini-cart-note">
          Add order note
        </button>

        <div class="order-note-toggle__content" id="mini-cart-note">
          <label for="mini-cart__notes">Add order note</label>
          <textarea name="note" id="mini-cart__notes" rows="5">{{ cart.note }}</textarea>
          <button class="button full"><span>Save</span></button>
          <div class="order-note-toggle__content-overlay"></div>
        </div>

        <div class="cart-drawer-buttons">
          <form action="/cart" method="post" novalidate>
            <button type="submit" class="button accent checkout full" name="checkout" title="Checkout">
              <span>Checkout</span>
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
