{% comment %} Snippet: product-gallery.liquid {% endcomment %}
<div class="product-gallery-sticky">
  <div class="product-gallery-container thumbnails-left" id="MediaGallery-template--{{ section.id }}">
    <div class="product-image-container">
      <product-slider
        id="Product-Slider"
        class="product-images static-dots flickity-enabled is-draggable flickity-resize"
        data-captions="true"
        data-hide-variants="false"
      >
        {% for image in product.media %}
          <div class="product-images__slide" data-media-id="Media-{{ section.id }}-{{ image.id }}">
            <div class="product-single__media aspect-ratio">
              <a href="{{ image | img_url: 'master' }}" class="product-single__media-zoom" target="_blank" title="Zoom">
                <svg width="20" height="20">
                  <!-- SVG content for zoom icon -->
                </svg>
              </a>
              <img src="{{ image | img_url: 'master' }}" class="lazyautosizes" alt="Product Image">
            </div>
          </div>
        {% endfor %}
      </product-slider>

      <scroll-shadow>
        <div id="Product-Thumbnails" class="product-thumbnail-container">
          {% for image in product.images %}
            <div class="product-thumbnail">
              <img src="{{ image | img_url: 'master' }}" alt="Thumbnail">
            </div>
          {% endfor %}
        </div>
      </scroll-shadow>
    </div>
  </div>
</div>
