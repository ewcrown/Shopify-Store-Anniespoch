{{ 'sale-product-grid.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

<style>

  .sale-product-grid .product-grid{
    display: grid;
    grid-template-columns: repeat(3,1fr);
    list-style: none;
    gap: 20px;
}
.sale-product-grid .carousel__slide {
  width: 100%;
  max-width: 100%;
  padding: 0;
}

@media (max-width: 767px) {
  .sale-product-grid .product-grid{
    grid-template-columns: repeat(1,1fr);
    gap: 10px;
    margin:0 !important;
  }
}
</style>

<section class="sale-product-grid sale-product-grid-{{ section.id }}" id="sale-product-grid-{{ section.id }}">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <div class="section-header">
        <h2 class="section-heading">{{ section.settings.heading }}</h2>
        {% if section.settings.subheading != blank %}
          <p class="section-subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}
    
    {% if section.settings.collection != blank %}
      <ul class="product-grid grid grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop" role="list">
        {% for product in section.settings.collection.products limit: section.settings.products_limit %}
          <li class="grid__item sale-product-item">
            <div class="sale-product-card-wrapper">
              {% render 'ai-card', product: product %}
              {% if section.settings.show_add_to_cart %}
                {% assign first_variant = product.selected_or_first_available_variant %}
                {% if first_variant and first_variant.available and product.available %}
                  <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="sale-product-add-to-cart-form">
                    <input type="hidden" name="id" value="{{ first_variant.id }}">
                    <button type="submit" class="sale-product-add-to-cart-button" name="add">
                      {% if section.settings.add_to_cart_text != blank %}
                        {{ section.settings.add_to_cart_text }}
                      {% else %}
                        Add to cart
                      {% endif %}
                    </button>
                  </form>
                {% else %}
                  <button type="button" class="sale-product-add-to-cart-button" disabled>
                    Sold out
                  </button>
                {% endif %}
              {% endif %}
            </div>
          </li>
        {% endfor %}
      </ul>
      
      {% if section.settings.button_text != blank and section.settings.button_url != blank %}
        <div class="section-footer">
          <a href="{{ section.settings.button_url }}" class="section-button">
            {{ section.settings.button_text }}
          </a>
        </div>
      {% endif %}
    {% else %}
      <p class="no-collection-message">Please select a collection in the section settings.</p>
    {% endif %}
  </div>
</section>

{% style %}
  .sale-product-grid-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  .sale-product-grid-{{ section.id }} .section-heading {
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.heading_size }}px;
  }
  .sale-product-grid-{{ section.id }} .section-button {
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
  }
  .sale-product-grid-{{ section.id }} .section-button:hover {
    background-color: {{ section.settings.button_hover_bg_color }};
  }
  .sale-product-grid-{{ section.id }} .sale-product-add-to-cart-button {
    background-color: {{ section.settings.cart_button_bg_color }};
    color: {{ section.settings.cart_button_text_color }};
  }
  .sale-product-grid-{{ section.id }} .sale-product-add-to-cart-button:hover:not(:disabled) {
    background-color: {{ section.settings.cart_button_hover_bg_color }};
  }
{% endstyle %}

<script>
  (function() {
    const sectionId = '{{ section.id }}';
    const addToCartForms = document.querySelectorAll(`#sale-product-grid-${sectionId} .sale-product-add-to-cart-form`);
    
    addToCartForms.forEach(form => {
      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const button = form.querySelector('.sale-product-add-to-cart-button');
        const originalText = button.textContent;
        
        // Disable button and show loading state
        button.disabled = true;
        button.classList.add('loading');
        
        const formData = new FormData(form);
        
        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            body: formData
          });
          
          const data = await response.json();
          
          if (data.status) {
            // Error occurred
            alert(data.description || 'An error occurred while adding the product to cart.');
            button.disabled = false;
            button.textContent = originalText;
            button.classList.remove('loading');
            return;
          }
          
          // Success - update cart count and drawer
          if (typeof window.updateCartCount === 'function') {
            window.updateCartCount();
          }
          
          // Dispatch custom event for cart update
          if (typeof window.dispatchCustomEvent === 'function') {
            window.dispatchCustomEvent('cart:item-added', {
              product: data.hasOwnProperty('items') ? data.items[0] : data
            });
          }
          
          // Update cart drawer if it exists
          const cartDrawer = document.querySelector('cart-drawer');
          if (cartDrawer && typeof cartDrawer.renderContents === 'function') {
            cartDrawer.renderContents(data);
          }
          
          // Open cart drawer
          const cartDrawerElement = document.getElementById('Cart-Drawer');
          if (cartDrawerElement) {
            document.body.classList.add('open-cc');
            cartDrawerElement.classList.add('active');
            cartDrawerElement.focus();
          }
          
          // Reset button
          button.disabled = false;
          button.textContent = originalText;
          button.classList.remove('loading');
          
        } catch (error) {
          console.error('Error adding to cart:', error);
          alert('An error occurred while adding the product to cart.');
          button.disabled = false;
          button.textContent = originalText;
          button.classList.remove('loading');
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Sale Product Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Holiday Favorites, Gifts, and Best Sellers"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_limit",
      "min": 3,
      "max": 24,
      "step": 1,
      "label": "Products to Show",
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2",
      "label": "Columns (Mobile)"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SHOP OUR FULL MENU"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
      "label": "Button Hover Background Color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    },
    {
      "type": "header",
      "content": "Add to Cart Button"
    },
    {
      "type": "checkbox",
      "id": "show_add_to_cart",
      "label": "Show Add to Cart Button",
      "default": true
    },
    {
      "type": "text",
      "id": "add_to_cart_text",
      "label": "Add to Cart Button Text",
      "default": "Add to cart"
    },
    {
      "type": "color",
      "id": "cart_button_bg_color",
      "label": "Add to Cart Button Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "cart_button_text_color",
      "label": "Add to Cart Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "cart_button_hover_bg_color",
      "label": "Add to Cart Button Hover Background Color",
      "default": "#333333"
    }
  ],
  "presets": [
    {
      "name": "Sale Product Grid"
    }
  ]
}
{% endschema %}

