{{ 'nU6IdwHEVoHw.css' | asset_url | stylesheet_tag }}

<style>
    --color-header-links:{{ section.settings.primary_color  }} ;
    --font-navigation-scale;{{ section.settings.font-size }};
  .thb-full-menu a,.thb-full-menu>li>a {
     font-weight:{{ section.settings.font-weight }} ;
     color: --color-header-links;
     font-size:  --font-navigation-scale
  }
</style>
<div
  id="shopify-section-sections--17879067197694__header"
  class="shopify-section shopify-section-group-header-group header-section"
>
  <!-- Use real header landmark -->
  <header class="site-header" role="banner">
    <div class="header--inner">
      
      <!-- Mobile menu toggle -->
      <div class="thb-header-mobile-left">
        <details class="mobile-toggle-wrapper active">
          <summary class="mobile-toggle" aria-label="Toggle mobile menu">
            <span></span>
            <span></span>
            <span></span>
          </summary>
          <nav id="mobile-menu" class="mobile-menu-drawer" role="navigation" aria-label="Mobile menu">
            <div class="mobile-menu-drawer--inner">
              <ul class="mobile-menu">
                {% for item in section.settings['mobile-menu'].links %}
                  {% if forloop.first %}
                    <li>
                      <div class="ai-menu-item ai-{{ forloop.index }}" title="{{ item.title }}">
                        <div class="mega-div">
                          <span class="mega-t">{{ item.title }}</span>
                          <span class="ai-arrow">&gt;</span>
                        </div>
                        <div class="mega-menu-div">
                          {% render 'mobile-mega-menu', allcollections: section.blocks %}
                        </div>
                      </div>
                    </li>
                  {% else %}
                    <li>
                      <a href="{{ item.url }}" class="ai-menu-item ai-{{ forloop.index }}">
                        {{ item.title }}
                      </a>
                    </li>
                  {% endif %}
                {% endfor %}
              </ul>
              <div class="thb-mobile-menu-footer">
                <a class="thb-mobile-account-link" href="/account/login">
                  {% render 'icon-account' %} Login
                </a>
              </div>
            </div>
          </nav>
        </details>
      </div>

      <!-- Logo (home link, no landmark role here) -->
      <a class="logolink text-logo" href="{{ shop.url }}" aria-label="Home">
        <img srcset="{{ settings.logo | image_url: width: '200px' }}" 
             width="{{ settings.logo_width }}" 
             alt="{{ shop.name }} Home" />
      </a>

      <!-- Right side (search, account, cart) -->
      <div class="thb-secondary-area thb-header-right" aria-label="Header tools">
        <div class="thb-secondary-area-item">
          {% render 'header-search' %}
        </div>
        <a class="thb-secondary-area-item thb-secondary-myaccount"
           href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
           title="My Account">
          {% render 'icon-account' %}
        </a>
        <a class="thb-secondary-area-item thb-secondary-cart" href="/cart" id="cart-drawer-toggle">
          <div class="thb-secondary-item-icon" aria-label="Cart status">
            {% render 'cart-icon' %}
            <span class="thb-item-count">0</span>
          </div>
        </a>
      </div>

      <!-- Desktop nav -->
      <nav class="full-menu" role="navigation" aria-label="Main menu">
        <ul class="thb-full-menu" role="menubar">
          {% for item in section.settings.menu.links %}
            <li role="none" class="menu-item">
              <a role="menuitem" href="{{ item.url }}">{{ item.title }}</a>
              {% if forloop.first %}
                {% render 'mega-menu', allcollections: section.blocks %}
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </nav>

    </div>
  </header>
</div>


<script
  defer="defer"
>
  const searchInput = document.querySelector('.header__search input[type="search"]');
  const predictiveSearchBox = document.querySelector('.predictive-search');

  searchInput.addEventListener('input', function () {
    const searchQuery = searchInput.value;

    if (searchQuery.length > 2) {
      fetch(`/search/suggest.json?q=${searchQuery}&resources[type]=product`)
        .then(response => response.json())
        .then(data => {
          let searchResults = data.resources.results.products;
          predictiveSearchBox.innerHTML = '';

          if (searchResults.length > 0) {
            searchResults.forEach(product => {
              let productHtml = `
                <div class="search-result-item">
                  <a href="${product.url}" style="text-decoration:none">
                    <img src="${product.featured_image.url}" alt="${product.title}">
                    <div class="col-inner" >
                        <span>${product.title}</span>
                        <p class="price">
                              <ins>
                                <span class="amount ">$${product.price}</span>
                              </ins>      
                        </p>
                    </div>
                  </a>
                </div>
              `;
              predictiveSearchBox.innerHTML += productHtml;
            });
            predictiveSearchBox.style.display = 'block';
          } else {
            predictiveSearchBox.style.display = 'none';
          }
        });
    } else {
      predictiveSearchBox.style.display = 'none';
    }
  });
</script>
<script src="{{ 'header-section.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "t:sections.header.name",
  "class": "section-header",
  "max_blocks": 6,
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "t:sections.header.settings.menu.label"
    },
    {
          "type": "link_list",
          "id": "mobile-menu",
          "label": "Menu"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Menu Color",
      "default": "#646464"
    },
    {
      "type": "range",
      "id": "font-size",
      "min": 1,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "font size",
      "default": 9
    },
    {
      "type": "range",
      "id": "font-weight",
      "min": 100,
      "max": 900,
      "step": 100,
      "label": "font weight",
      "default": 400
    }
  ],
  "blocks": [
    {
      "type": "featured_collection",
      "name": "t:sections.collection-list.blocks.featured_collection.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.collection-list.blocks.featured_collection.settings.collection.label"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        },

        {
          "type": "color",
          "id": "color",
          "label": "Background"
        },
        {
          "type": "text",
          "id": "menu-title",
          "default": "Title",
          "label": "Title"
        }
      ]

    }

  ],
  "presets": [
    {
      "name": "t:sections.header.name",
      "blocks": [
        {
          "type": "featured_collection"
        },
        {
          "type": "featured_collection"
        },
        {
          "type": "featured_collection"
        }
      ]
    }
  ]
}
{% endschema %}
