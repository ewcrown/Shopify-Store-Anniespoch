{{ 'sale-promo-banner.css' | asset_url | stylesheet_tag }}

<section class="sale-promo-banner sale-promo-banner-{{ section.id }}" id="sale-promo-banner-{{ section.id }}">
  <div class="page-width">
    <div class="promo-banner-wrapper">
      {% if section.settings.badge_text != blank %}
        <div class="promo-badge">{{ section.settings.badge_text }}</div>
      {% endif %}
      
      {% if section.settings.heading != blank %}
        <h2 class="promo-heading">{{ section.settings.heading }}</h2>
      {% endif %}
      
      {% if section.settings.subheading != blank %}
        <p class="promo-subheading">{{ section.settings.subheading }}</p>
      {% endif %}
      
      {% if section.settings.description != blank %}
        <div class="promo-description-wrapper">
          <div class="promo-description promo-description-truncated">{{ section.settings.description }}</div>
          <button type="button" class="read-more-toggle" aria-expanded="false">
            <span class="read-more-text">Read more</span>
            <span class="read-less-text" style="display: none;">Read less</span>
          </button>
        </div>
      {% endif %}
      
      {% if section.settings.product != blank %}
        <div class="promo-product-info">
          <div class="promo-product-price">
            {% if section.settings.original_price != blank %}
              <span class="original-price">{{ section.settings.original_price }}</span>
            {% endif %}
            <span class="current-price">{{ section.settings.current_price | default: 'FREE' }}</span>
          </div>
        </div>
      {% endif %}
      
      {% if section.settings.button_text != blank and section.settings.button_url != blank %}
        <a href="{{ section.settings.button_url }}" class="button promo-button">
          {{ section.settings.button_text }}
        </a>
      {% endif %}
      
      {% if section.settings.image != blank %}
        <div class="promo-image-wrapper">
          <img 
            src="{{ section.settings.image | image_url: width: 600 }}" 
            alt="{{ section.settings.image.alt | escape }}"
            class="promo-image"
            loading="lazy"
          >
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% style %}
  .sale-promo-banner-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  .sale-promo-banner-{{ section.id }} .promo-heading {
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.heading_size }}px;
  }
  .sale-promo-banner-{{ section.id }} .promo-button {
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
  }
  .sale-promo-banner-{{ section.id }} .promo-button:hover {
    background-color: {{ section.settings.button_hover_bg_color }};
  }
{% endstyle %}

<script>
  // Read more/read less functionality
  (function() {
    const sectionId = '{{ section.id }}';
    const descriptionWrappers = document.querySelectorAll(`#sale-promo-banner-${sectionId} .promo-description-wrapper`);
    
    descriptionWrappers.forEach(wrapper => {
      const description = wrapper.querySelector('.promo-description');
      const toggleButton = wrapper.querySelector('.read-more-toggle');
      const readMoreText = toggleButton.querySelector('.read-more-text');
      const readLessText = toggleButton.querySelector('.read-less-text');
      
      if (!description || !toggleButton) return;
      
      // Set initial height
      const fullHeight = description.scrollHeight;
      const lineHeight = parseInt(window.getComputedStyle(description).lineHeight) || 24;
      const maxLines = 3;
      const maxHeight = lineHeight * maxLines;
      
      // Only show toggle if content exceeds max height
      if (fullHeight <= maxHeight) {
        toggleButton.style.display = 'none';
        description.classList.remove('promo-description-truncated');
        return;
      }
      
      // Set truncated height
      description.style.maxHeight = maxHeight + 'px';
      description.style.overflow = 'hidden';
      description.style.transition = 'max-height 0.3s ease';
      
      toggleButton.addEventListener('click', function() {
        const isExpanded = toggleButton.getAttribute('aria-expanded') === 'true';
        
        if (isExpanded) {
          // Collapse
          description.style.maxHeight = maxHeight + 'px';
          description.classList.add('promo-description-truncated');
          readMoreText.style.display = 'inline';
          readLessText.style.display = 'none';
          toggleButton.setAttribute('aria-expanded', 'false');
        } else {
          // Expand
          description.style.maxHeight = fullHeight + 'px';
          description.classList.remove('promo-description-truncated');
          readMoreText.style.display = 'none';
          readLessText.style.display = 'inline';
          toggleButton.setAttribute('aria-expanded', 'true');
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Sale Promo Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "FREE Hot Lava Hot Sauce with Your Purchase!"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FREE Hot Lava Hot Sauce with Your Purchase!"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Purchase any Meal or Bundle and we'll add it to your order automatically. No coupon needed."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>The sauce that always sells out is BACK! Turn up the heat on your favorite meals with Hot Lava Hot Sauce, the ultimate chili blend that's as versatile as it is flavorful.</p>"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "original_price",
      "label": "Original Price",
      "default": "$8.95"
    },
    {
      "type": "text",
      "id": "current_price",
      "label": "Current Price",
      "default": "FREE"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Our Full Menu"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
      "label": "Button Hover Background Color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Sale Promo Banner"
    }
  ]
}
{% endschema %}

