{{ 'section-about-banner.css' | asset_url | stylesheet_tag }}

<style>
.about-us-hero {
  background: url({{ section.settings.image | image_url }});
  background-size: {{ section.settings.background_size }};
  background-position: {{ section.settings.background_position }};
  padding: {{ section.settings.padding_top }}rem {{ section.settings.padding_right }}rem {{ section.settings.padding_bottom }}rem {{ section.settings.padding_left }}rem;
}

.about-us-hero .text-content {
  width: {{ section.settings.width }}%;
}

/* Mobile Background with Fallback */
@media only screen and (max-width: 768px) {
  .about-us-hero {
    background: url(
      {% if section.settings.mobile_image != blank %}
        {{ section.settings.mobile_image | image_url }}
      {% else %}
        {{ section.settings.image | image_url }}
      {% endif %}
    );
    background-size: cover;
    padding: 20rem 5rem 5rem 5rem;
  }

  .about-us-hero .text-content {
    width: 100% !important;
  }
}

/* Block Styling */
{% for block in section.blocks %}
.about-us-hero .year {
  font-size: {{ block.settings.year_size }}px;
  color: {{ block.settings.year_color }};
  background: {{ block.settings.year_background }};
  border-radius: {{ block.settings.year_border_radius }}px;
  padding: {{ block.settings.padding_top }}px {{ block.settings.padding_right }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_left }}px;
}

.about-us-hero .about-heading {
  font-size: {{ block.settings.heading_size }}px;
  color: {{ block.settings.title_color }};
}
{% endfor %}

.hero-link-wrapper {
  display: block;
  text-decoration: none;
  color: inherit;
}
</style>

<a href="{{ section.settings.image_link }}" class="hero-link-wrapper">
  <div class="template-{{ section.id }}-{{ page.title | handleize }} about-us-hero">
    <section class="about-section">
      <div class="text-content">
        {% for block in section.blocks %}
          {% case block.type %}

            {% when 'year' %}
              <span class="year">{{ block.settings.year }}</span>

            {% when 'heading' %}
              <h1 class="about-heading">{{ block.settings.heading }}</h1>

            {% when 'text' %}
              <div style="font-size: {{ block.settings.text_size }}px; color: {{ block.settings.text_color }};">
                {{ block.settings.text }}
              </div>

            {% when 'sign' %}
              <p class="signature" style="font-size: {{ block.settings.sign_size }}px; color: {{ block.settings.sign_color }};">
                Best regards,<br>{{ block.settings.sign }}
              </p>

            {% when 'link' %}
              <p><strong>{{ block.settings.link }}</strong></p>

            {% when 'button' %}
              <a
                href="{{ block.settings.link }}"
                style="
                  font-size: {{ block.settings.text_size }}px;
                  border-radius: {{ block.settings.text_radius }}px;
                  background: {{ block.settings.bg_color }};
                  color: {{ block.settings.text_color }};
                  padding: {{ block.settings.padding_top }}px {{ block.settings.padding_right }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_left }}px;
                "
              >
                {{ block.settings['btn-title'] }}
              </a>

          {% endcase %}
        {% endfor %}
      </div>
    </section>
  </div>
</a>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background Image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile Background Image" },
    { "type": "url", "id": "image_link", "label": "Background Image Link" },

    { "type": "range", "id": "width", "label": "Text Width", "min": 1, "max": 100, "step": 1, "unit": "%", "default": 44 },

    { "type": "range", "id": "padding_top", "label": "Padding Top", "min": 0, "max": 100, "step": 1, "unit": "rem", "default": 5 },
    { "type": "range", "id": "padding_bottom", "label": "Padding Bottom", "min": 0, "max": 100, "step": 1, "unit": "rem", "default": 5 },
    { "type": "range", "id": "padding_left", "label": "Padding Left", "min": 0, "max": 100, "step": 1, "unit": "rem", "default": 5 },
    { "type": "range", "id": "padding_right", "label": "Padding Right", "min": 0, "max": 100, "step": 1, "unit": "rem", "default": 5 },

    {
      "type": "select",
      "id": "background_size",
      "label": "Background Size",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" },
        { "value": "auto", "label": "Auto" }
      ],
      "default": "cover"
    },

    {
      "type": "select",
      "id": "background_position",
      "label": "Background Position",
      "options": [
        { "value": "left top", "label": "Left Top" },
        { "value": "center center", "label": "Center" },
        { "value": "right bottom", "label": "Right Bottom" }
      ],
      "default": "center center"
    }
  ],

  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        { "type": "inline_richtext", "id": "heading", "label": "Heading" },
        { "type": "range", "id": "heading_size", "label": "Heading Size", "min": 10, "max": 100, "step": 1, "unit": "px", "default": 54 },
        { "type": "color", "id": "title_color", "label": "Title Color", "default": "#000000" }
      ]
    },
    {
      "type": "year",
      "name": "Year",
      "limit": 1,
      "settings": [
        { "type": "inline_richtext", "id": "year", "label": "Year" },
        { "type": "range", "id": "year_size", "label": "Year Size", "min": 10, "max": 100, "step": 1, "unit": "px", "default": 40 },
        { "type": "color", "id": "year_color", "label": "Year Color", "default": "#ffffff" },
        { "type": "color", "id": "year_background", "label": "Year Background", "default": "#000000" },
        { "type": "range", "id": "year_border_radius", "label": "Border Radius", "min": 0, "max": 50, "step": 1, "unit": "px", "default": 5 },
        { "type": "range", "id": "padding_top", "label": "Padding Top", "min": 0, "max": 50, "step": 1, "unit": "px", "default": 5 },
        { "type": "range", "id": "padding_bottom", "label": "Padding Bottom", "min": 0, "max": 50, "step": 1, "unit": "px", "default": 5 },
        { "type": "range", "id": "padding_left", "label": "Padding Left", "min": 0, "max": 50, "step": 1, "unit": "px", "default": 10 },
        { "type": "range", "id": "padding_right", "label": "Padding Right", "min": 0, "max": 50, "step": 1, "unit": "px", "default": 10 }
      ]
    }
  ],

  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "heading" },
        { "type": "year" }
      ]
    }
  ]
}
{% endschema %}
