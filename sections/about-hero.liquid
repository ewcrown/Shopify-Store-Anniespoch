{{ 'section-about-banner.css' | asset_url | stylesheet_tag }}
<style>
    .about-us-hero {
    background: url({{ section.settings.image | image_url }});
    background-size: {{ section.settings.background_size }};
    background-position: {{ section.settings.background_position }};
    padding: {{ section.settings.padding_top }}rem {{ section.settings.padding_right }}rem {{ section.settings.padding_bottom }}rem {{ section.settings.padding_left }}rem;
  }

  .about-us-hero .text-content {
    width: {{ section.settings.width }}%;
  }

  {% for block in section.blocks %}
    .about-us-hero .year {
      font-size: {{ block.settings.year_size }}px;
      color: {{ block.settings.year_color }};
      background: {{ block.settings.year_background }};
      border-radius: {{ block.settings.year_border_radius }}px;
      padding: {{ section.settings.padding_top }}px {{ section.settings.padding_right }}px {{ section.settings.padding_bottom }}px {{ section.settings.padding_left }}px;
    }

    .about-us-hero .about-heading {
      font-size: {{ block.settings.heading_size }}px;
      color: {{ block.settings.title_color }};
    }
  {% endfor %}

  /* Media Queries for Different Screen Sizes */
  @media only screen and (max-width: 1024px) { /* Tablet/Large mobile */
    .about-us-hero {
      padding: calc({{ section.settings.padding_top }}rem / 1.5)
               calc({{ section.settings.padding_right }}rem / 1.5)
               calc({{ section.settings.padding_bottom }}rem / 1.5)
               calc({{ section.settings.padding_left }}rem / 1.5);
    }

    .about-us-hero .text-content {
      width: 90%;
    }

    {% for block in section.blocks %}
      .about-us-hero .year {
        font-size: calc({{ block.settings.year_size }}px / 1.5);
        padding: calc({{ section.settings.padding_top }}px / 1.5)
                 calc({{ section.settings.padding_right }}px / 1.5)
                 calc({{ section.settings.padding_bottom }}px / 1.5)
                 calc({{ section.settings.padding_left }}px / 1.5);
      }

      .about-us-hero .about-heading {
        font-size: calc({{ block.settings.heading_size }}px / 1.5);
      }
    {% endfor %}
  }

  @media only screen and (max-width: 768px) { /* Small Tablet */
    .about-us-hero {
      padding: calc({{ section.settings.padding_top }}rem / 2)
               calc({{ section.settings.padding_right }}rem / 2)
               calc({{ section.settings.padding_bottom }}rem / 2)
               calc({{ section.settings.padding_left }}rem / 2);
    }

    .about-us-hero .text-content {
      width: 100% !important;
    }

    {% for block in section.blocks %}
      .about-us-hero .year {
        font-size: calc({{ block.settings.year_size }}px / 2);
        padding: calc({{ section.settings.padding_top }}px / 2)
                 calc({{ section.settings.padding_right }}px / 2)
                 calc({{ section.settings.padding_bottom }}px / 2)
                 calc({{ section.settings.padding_left }}px / 2);
      }

      .about-us-hero .about-heading {
        font-size: calc({{ block.settings.heading_size }}px / 2);
      }
    {% endfor %}
  }

  @media only screen and (max-width: 480px) { /* Mobile Phones */
    .about-us-hero {
      padding: calc({{ section.settings.padding_top }}rem / 3)
               calc({{ section.settings.padding_right }}rem / 3)
               calc({{ section.settings.padding_bottom }}rem / 3)
               calc({{ section.settings.padding_left }}rem / 3);
    }

    {% for block in section.blocks %}
      .about-us-hero .year {
        font-size: calc({{ block.settings.year_size }}px / 3);
        padding: calc({{ section.settings.padding_top }}px / 3)
                 calc({{ section.settings.padding_right }}px / 3)
                 calc({{ section.settings.padding_bottom }}px / 3)
                 calc({{ section.settings.padding_left }}px / 3);
      }

      .about-us-hero .about-heading {
        font-size: calc({{ block.settings.heading_size }}px / 3);
      }
    {% endfor %}
  }
</style>
<div
  class="template-{{ section.id }}-{{ page.title | handleize }} about-us-hero"
>
  <section class="about-section">
    <div class="text-content">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'year' %}
            <span
              class="year"
            >
              {{ block.settings.year }}
            </span>

          {% when 'heading' %}
            <h1 class="about-heading">
              {{ block.settings.heading }}
            </h1>

          {% when 'text' %}
            <div style="font-size: {{ block.settings.text_size }}px; color: {{ block.settings.text_color }};">
              {{ block.settings.text }}
            </div>

          {% when 'sign' %}
            <p
              class="signature"
              style="font-size: {{ block.settings.sign_size }}px; color: {{ block.settings.sign_color }};"
            >
              Best regards,<br>
              {{ block.settings.sign }}
            </p>
          {% when 'link' %}
            <p>
              <strong>{{ block.settings.link }}</strong>
            </p>
          {% when 'button' %}
            <a
              href="{{ block.settings.link }}"
              style="
                font-size:{{ block.settings.text_size }};border-radius:{{ block.settings.text_radius }}px;background:{{ block.settings.bg_color }};color:{{ block.settings.text_color }};
                padding: {{ block.settings.padding_top }}px {{ block.settings.padding_right }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_left }}px;
              "
              ;
            >
              {{- block.settings['btn-title'] -}}
            </a>
        {% endcase %}
      {% endfor %}
    </div>
  </section>
</div>

