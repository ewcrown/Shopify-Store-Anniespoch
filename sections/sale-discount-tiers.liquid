{{ 'sale-discount-tiers.css' | asset_url | stylesheet_tag }}

<section class="sale-discount-tiers sale-discount-tiers-{{ section.id }}" id="sale-discount-tiers-{{ section.id }}">
  <div class="page-width">
    <div class="discount-tiers-wrapper">
      {% for block in section.blocks %}
        {% if block.settings.image != blank %}
          <div class="discount-tier-image" {{ block.shopify_attributes }}>
            {% if block.settings.link_url != blank %}
              <a href="{{ block.settings.link_url }}" class="tier-image-link">
            {% endif %}
            <img 
              src="{{ block.settings.image | image_url: width: 800 }}" 
              alt="{{ block.settings.image.alt | default: 'Discount Tier' | escape }}"
              class="tier-image"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              loading="lazy"
            >
            {% if block.settings.link_url != blank %}
              </a>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% style %}
  .sale-discount-tiers-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Sale Discount Tiers",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f5f5f5"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Discount Tier Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Upload the discount tier image"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL",
          "info": "Optional: Add a link to the image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sale Discount Tiers"
    }
  ]
}
{% endschema %}

