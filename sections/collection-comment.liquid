<style>
  #poch-collection-2-comment {
    overflow-x: hidden;
    max-width: 100%;
  }
  .poch-collection-2-comment-grid {
    display: grid;
    gap: 1.5rem;
  }
  @media (max-width: 749px) {
    .poch-collection-2-comment-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr) !important;
    }
  }
</style>
<section class="poch-collection-2-comment" id="poch-collection-2-comment">
  <div class="poch-collection-2-comment-row">
    <div class="page-width">
      <div class="poch-collection-2-comment-grid" style="grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);">
        {% for block in section.blocks %}
          <div
            class="poch-collection-2-comment-col"
            {{ block.shopify_attributes }}
            {% if block.settings.image != blank %}
              style="background-image: url({{ block.settings.image | image_url: width: 1000 }})"
            {% endif %}
          >
            <div class="overlay">
              {% if block.settings.comment != blank %}
                <h3 class="poch-collection-comment-title">{{ block.settings.comment }}</h3>
              {% endif %}
              {% if block.settings.txt != blank %}
                <p class="poch-collection-comment-txt">{{ block.settings.txt }}</p>
              {% endif %}
              {% if block.settings.author != blank %}
                <p class="poch-collection-comment-author">{{ block.settings.author }}</p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection Comment",
  "settings": [
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 1,
      "label": "Columns (Desktop)"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (Mobile)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    }
  ],
  "blocks": [
    {
      "type": "comment",
      "name": "Comment",
      "settings": [
        {
          "type": "richtext",
          "id": "comment",
          "label": "Comment"
        },
        {
          "type": "text",
          "id": "txt",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Comment",
      "blocks": [
        {
          "type": "comment",
          "settings": {
            "comment": "<p>Our dogs cannot get enough of the Mega Muttkins.</p>",
            "txt": "Shhh! It's their favorite treat!",
            "author": "– Melissa A"
          }
        }
      ]
    }
  ]
}
{% endschema %}
