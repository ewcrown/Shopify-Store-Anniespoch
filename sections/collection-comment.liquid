<section class="poch-collection-2-comment" id="poch-collection-2-comment">
  <div class="poch-collection-2-comment-row">
    <div class="page-width">
      <div
        class="poch-collection-2-comment-col "
        style="background:url({{ section.settings.image | image_url : width : '1000' }})"
      >
        <div class="overlay">
          <h3 class="poch-collection-comment-title">{{ section.settings.comment }}</h3>
          <p class="poch-collection-comment-txt">{{ section.settings.txt }}</p>

          <p class="poch-collection-comment-author">{{ section.settings.author }}</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection Comment",
  "settings": [
    {
      "type": "richtext",
      "id": "comment",
      "label": "Comment",
      "default":"<p>Our dogs cannot get enough of the Mega Muttkins. They love the biscuit around the middle, but go on to work on the bone for months or even years later. I can’t tell you how many stripped down bones we have all around the house. My husband thinks we don’t need anymore, but I just ordered six more.</p>"
    },
    {
      "type": "text",
      "id": "txt",
      "label": "Text",
      "default":"Shhh! It’s their favorite treat!"
    },
    {
      "type": "text",
      "id": "author",
      "label": "Author",
      "default":"– Melissa A"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background"
    }
  ],
  "presets": [
    {
      "name": "Collection Comment"
    }
  ]
}
{% endschema %}
