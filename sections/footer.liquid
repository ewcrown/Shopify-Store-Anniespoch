{{ 'section-footer.css' | asset_url | stylesheet_tag }}
<div id="shopify-section-sections--18200342757670__footer" class="shopify-section shopify-section-group-footer-group">
  <theme-footer class="footer" id="footer">
    <div class="row">
      <div class="small-12 medium-5 columns">
        <div class="widget widget--text text-left">
          <img
            class="retina_size lazyautosizes lazyloaded"
            width="154"
            height="154"
            data-sizes="auto"
            src="{{ section.settings.footerlogo | image_url : width: '200px' }}"
            data-srcset="{{ section.settings.footerlogo | image_url : width: '200px' }}"
            fetchpriority="low"
            alt=""
            style="object-position: 50.0% 50.0%;"
            sizes="154px"
            srcset="{{ section.settings.footerlogo | image_url : width: '200px' }}"
          >
          <p class="footer-logo-caption">Not just another treat! Handmade treats from our kitchen for your pooch.</p>
          <p style="display: flex;gap:10px;">
            {% if settings.social_instagram_link %}
              <a
                href="{{ settings.social_instagram_link }}"
                target="_blank"
                style="
                  width: 25px;
                  display: block;
                "
              >
                {%- render 'icon-instagram' %}
              </a>
            {% endif %}
            {% if settings.social_facebook_link %}
              <a
                target="_blank"
                href="{{ settings.social_facebook_link}}"
                style="
                  width: 25px;
                  display: block;
                "
              >
                {%- render 'icon-facebook' %}
              </a>
            {% endif %}
          </p>
        </div>
      </div>
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'text' -%}
            <div class="small-12 medium-4 large-4 columns widget--menu-column">
              {%- if block.settings.heading != blank -%}
                <h2 class="footer-block__heading inline-richtext">{{- block.settings.heading -}}</h2>
              {%- endif -%}
              <div class="footer-block__details-content rte">
                {{ block.settings.subtext }}
              </div>
            </div>
          {%- when 'link_list' -%}
            <div class="small-12 medium-3 large-3 columns widget--menu-column">
              <div class="widget widget--menu">
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer-block__heading inline-richtext">{{- block.settings.heading -}}</h2>
                {%- endif -%}
                <ul class="thb-widget-menu">
                  {% assign menu_block = section.blocks | where: 'type', 'link_list' | first %}
                  {% if menu_block %}
                    {% assign menu_links = menu_block.settings.menu.links %}
                    {% if menu_links %}
                      {% for link in menu_links %}
                        <li>
                          <a href="{{ link.url }}" title="{{ link.title }}">{{ link.title }}</a>
                        </li>
                      {% endfor %}
                    {% else %}
                      <p>No links found in the menu.</p>
                    {% endif %}
                  {% else %}
                    <p>No menu block found.</p>
                  {% endif %}
                  <!--
                    <li class="">
                      <a href="/pages/about" title="Become a retailer">Become a retailer</a>
                    </li>
                    <li class="">
                      <a href="#" title="Corporate orders">Corporate orders</a>
                    </li>
                    <li class="">
                      <a href="#" title="Affiliates">Affiliates</a>
                    </li>
                    <li class="">
                      <a href="#" title="Gift cards">Gift cards</a>
                    </li>
                    <li class="">
                      <a href="/pages/contact" title="Contact">Contact</a>
                    </li>
                  -->
                </ul>
              </div>
            </div>
        {% endcase %}
      {% endfor %}
      {% comment %}
        <div class="small-12 medium-4 columns">
          <div class="widget widget--signup">
            <div class="thb-widget-title">Subscribe to our newsletter</div>
            <p>Sign up for our newsletter and receive 10% off your first order!</p>
            <div class="signup-container">
              <form method="post" action="/contact#contact_form" id="contact_form" accept-charset="UTF-8" class="signup-form">
                <input type="hidden" name="form_type" value="customer">
                <input type="hidden" name="utf8" value="✓">
                <fieldset>
                  <input name="contact[tags]" type="hidden" value="newsletter">
                  <div class="field">
                    <input placeholder="Email" type="email" id="NewsletterForm--sections--18200342757670__footer" name="contact[email]" autocorrect="off" autocapitalize="off" autocomplete="email" value="" pattern="^([a-zA-Z0-9_\-\.]+)@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([a-zA-Z0-9\-]+\.)+))([a-zA-Z]{2,4}|[0-9]{1,10})(\]?)$" title="xxx@xxx.xxx" required="">
                    <label class="field__label" for="NewsletterForm--sections--18200342757670__footer"> Email </label>
                  </div>
                  <button class="submit" type="submit" aria-label="Enter your email">
                    <svg width="15" height="11" viewBox="0 0 15 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M0.799805 5.5H12.7998" stroke="var(--color-body)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                      <path d="M9.49976 1L13.9998 5.5L9.49976 10" stroke="var(--color-body)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                  </button>
                </fieldset>
              </form>
            </div>
          </div>
        </div>
      {% endcomment %}
    </div>
    <div class="sub-footer">
      <div class="row">
        <div class="small-12 columns">
          <hr>
        </div>
        <div class="small-12 columns">
          <p>© 2024 Annie’s Pooch Pops, All rights reserved.</p>
        </div>
      </div>
    </div>
  </theme-footer>
  <script
    src="//vision-pets.myshopify.com/cdn/shop/t/2/assets/footer.js?v=179106030804079168351697883390"
    defer="defer"
  ></script>
</div>

