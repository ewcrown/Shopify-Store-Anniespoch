                              width="14"
                              height="15"
                              viewBox="0 0 14 15"
                              fill="none"
                              xmlns="http://www.w3.org/2000/svg"
                            >
                              <path
                                  d="M6.87447 0.692352C8.69623 0.700513 10.4416 1.42529 11.7333 2.71C12.7957 3.78519 13.4776 5.17808 13.6753 6.6766C13.8731 8.17513 13.5757 9.69722 12.8286 11.0112C12.2281 12.058 11.3605 12.9268 10.3144 13.5287C9.26838 14.1305 8.08131 14.444 6.87447 14.4371C6.21471 14.4416 5.55762 14.3529 4.9227 14.1735C5.26858 13.6135 5.49917 13.1112 5.6227 12.6912L6.10858 10.8053C6.22388 11.0359 6.44623 11.2335 6.76741 11.4065C7.09682 11.5712 7.42623 11.6618 7.78858 11.6618C8.50505 11.6618 9.14741 11.4559 9.71564 11.0441C10.2998 10.6112 10.7552 10.0277 11.0333 9.35588C11.3515 8.59189 11.5085 7.77042 11.4945 6.94294C11.4945 5.87235 11.0827 4.95823 10.2674 4.17588C9.84957 3.78241 9.35783 3.47573 8.82066 3.27359C8.2835 3.07144 7.71157 2.97785 7.138 2.99823C6.37211 2.99823 5.65564 3.13 5.01329 3.39353C4.21627 3.69641 3.52707 4.22905 3.03301 4.92395C2.53896 5.61886 2.26227 6.44477 2.23799 7.29706C2.23799 7.9147 2.35329 8.45823 2.59211 8.92765C2.8227 9.38882 3.16858 9.71823 3.63799 9.91588C3.72035 9.94882 3.79447 9.94882 3.85211 9.91588C3.90976 9.89118 3.95094 9.83353 3.97564 9.75117L4.12388 9.19117C4.16505 9.06765 4.14035 8.94412 4.03329 8.82059C3.71214 8.44892 3.54433 7.96904 3.56388 7.47823C3.55667 7.03307 3.64069 6.59114 3.81076 6.17967C3.98084 5.76821 4.23337 5.39593 4.55278 5.08577C4.8722 4.77561 5.25175 4.53414 5.66803 4.37624C6.08432 4.21834 6.52853 4.14735 6.97329 4.16765C7.87094 4.16765 8.57094 4.41471 9.06505 4.90059C9.56741 5.3947 9.8227 6.02882 9.8227 6.81118C9.8227 7.47 9.73211 8.07941 9.55094 8.63118C9.40539 9.13047 9.14283 9.58783 8.78505 9.96529C8.45564 10.2947 8.06858 10.4594 7.63211 10.4594C7.27799 10.4594 6.98976 10.3359 6.75917 10.0724C6.53682 9.80882 6.4627 9.49588 6.54505 9.14176C6.67078 8.70159 6.7998 8.26236 6.93211 7.82412L7.08035 7.22294C7.12976 7.00882 7.15447 6.83588 7.15447 6.68765C7.15447 6.39118 7.07211 6.14412 6.92388 5.9547C6.75917 5.76529 6.53682 5.66647 6.24035 5.66647C5.86976 5.66647 5.55682 5.83118 5.30976 6.17706C5.0