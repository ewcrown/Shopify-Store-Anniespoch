    "collection_faqs_Whx4UY": {
      "type": "collection-faqs",
      "blocks": {
        "faqs_wbVbm3": {
          "type": "faqs",
          "settings": {
            "ques": "Do I need to freeze a Muttkin™?  Does my dog need to finish the entire bone within two days?",
            "ans": "A Muttkin™ is a perishable product since we keep the Tasty Bits on the bone to maximize flavor. When you receive your delivery, we ask that you either freeze the bone for future use or give it to your pooch within 1-2 days. After your pooch chews off the Tasty Bits and Peanut Butter Biscuit, you do not need to re-freeze and can leave the Muttkin™ out for your pooch to chew at his/her leisure.  However, we recommend limiting chew sessions to 30-45 minutes at a time to reduce the amount of bone marrow consumed in one sitting."
          }
        },
        "faqs_htnXVD": {
          "type": "faqs",
          "settings": {
            "ques": "Is a Muttkin™ safe to give to my pooch?",
            "ans": "We only use a femur bone, which is one of the strongest bones in a cow. Like all dog chew treats, you should only provide a Muttkin™ to your pooch with proper supervision. If the bone splinters or breaks, please discard it immediately."
          }
        },
        "faqs_dw4NrB": {
          "type": "faqs",
          "settings": {
            "ques": "Why are there Shipping Surcharges?",
            "ans": "We ship throughout the continental US. However, due to the perishable nature of a Muttkin™, orders may be subject to additional shipping surcharges: Express Shipping Surcharge - locations beyond a 2-day ground delivery area from our bakery in Eastern Pennsylvania are subject to a $10  surcharge due to the additional cost to ship via 2-3 UPS Express.  Muttkin Surcharge $<50 Order - Muttkins ship via UPS Ground (or express if beyond a 2-day ground range from our bakery in eastern PA).  The additional $5 surcharge is the difference in rates charged to us to ship via UPS  versus a slower, cheaper service such as USPS."
          }
        }
      },
